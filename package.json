{
  "name": "dependency-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @dependency-explorer/web dev",
    "build": "pnpm --filter @dependency-explorer/web build",
    "preview": "pnpm --filter @dependency-explorer/web preview",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "discover": "pnpm --filter @dependency-explorer/discovery discover",
    "discover:apply": "pnpm --filter @dependency-explorer/discovery discover:apply",
    "discover:baseline": "pnpm --filter @dependency-explorer/discovery discover:baseline",
    "discover:aws:fetch": "pnpm --filter @dependency-explorer/discovery discover:aws:fetch",
    "discover:datadog:fetch": "pnpm --filter @dependency-explorer/discovery discover:datadog:fetch",
    "discover:jira:fetch": "pnpm --filter @dependency-explorer/discovery discover:jira:fetch",
    "discover:jira:draft": "pnpm --filter @dependency-explorer/discovery discover:jira:draft",
    "discover:scaffold": "pnpm --filter @dependency-explorer/discovery discover:scaffold",
    "docs:gen": "pnpm --filter @dependency-explorer/discovery docs:gen",
    "check": "pnpm typecheck && pnpm lint && pnpm check:exports && pnpm test && pnpm build",
    "lint": "eslint packages/web packages/schema",
    "discover:trace": "pnpm --filter @dependency-explorer/discovery discover:trace",
    "check:exports": "knip --include files,exports,types"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.42.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.1"
  },
  "packageManager": "pnpm@10.30.2+sha512.36cdc707e7b7940a988c9c1ecf88d084f8514b5c3f085f53a2e244c2921d3b2545bc20dd4ebe1fc245feec463bb298aecea7a63ed1f7680b877dc6379d8d0cb4"
}
